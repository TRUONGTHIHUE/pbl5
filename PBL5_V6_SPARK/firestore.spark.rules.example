// REFERENCE ONLY. Review against current website rules before Publish.
// Not auto-deployed. Never add a broad public allow alongside these rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(id) {
      return signedIn() && get(/databases/$(database)/documents/stores/$(id)).data.ownerUid == request.auth.uid;
    }
    function scanner(id) {
      return signedIn()
        && get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/stores/$(id)/authorizedDevices/$(request.auth.uid)).data.enabled == true
        && get(/databases/$(database)/documents/stores/$(id)).data.get('enabled', true) == true;
    }
    match /devices/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false; // trusted admin creates through Console
    }
    match /rfidStores/{rfid} {
      allow get: if rfid.matches('^([0-9A-F]{8}|[0-9A-F]{14}|[0-9A-F]{20})$')
        && resource.data.storeId is string
        && scanner(resource.data.storeId)
        && get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.rfidId == rfid;
      allow list, write: if false; // unique mapping ID, admin manages through Console
    }
    match /stores/{id} {
      allow get: if owner(id) || scanner(id);
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.rfidId is string
        && request.resource.data.rfidId.matches('^([0-9A-F]{8}|[0-9A-F]{14}|[0-9A-F]{20})$');
      allow update: if owner(id) && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.rfidId is string
        && request.resource.data.rfidId.matches('^([0-9A-F]{8}|[0-9A-F]{14}|[0-9A-F]{20})$');
      allow delete: if owner(id);
      match /authorizedDevices/{uid} {
        allow get: if owner(id) || (signedIn() && request.auth.uid == uid);
        allow list, delete: if owner(id);
        allow create, update: if owner(id) && request.resource.data.keys().hasOnly(['enabled'])
          && request.resource.data.enabled is bool;
      }
      match /products/{product} {
        allow read: if owner(id) || scanner(id);
        allow create, update: if owner(id) && request.resource.data.barcode is string
          && request.resource.data.barcode.size() > 0;
        allow delete: if owner(id);
      }
    }
  }
}
