// Based on the owner's existing website rules; adds scoped scanner reads.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function scannerCanRead(storeId) {
      return signedIn()
        && get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.get('enabled', false) == true
        && get(/databases/$(database)/documents/stores/$(storeId)/authorizedDevices/$(request.auth.uid)).data.get('enabled', false) == true
        && get(/databases/$(database)/documents/stores/$(storeId)).data.get('enabled', true) == true;
    }
    match /devices/{deviceUid} {
      allow get: if signedIn() && request.auth.uid == deviceUid;
      allow list, write: if false;
    }
    match /rfidStores/{rfidUid} {
      allow get: if rfidUid.matches('^([0-9A-F]{8}|[0-9A-F]{14}|[0-9A-F]{20})$')
        && resource.data.storeId is string
        && scannerCanRead(resource.data.storeId)
        && get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.rfidId == rfidUid;
      allow list, write: if false;
    }
    match /stores/{storeId} {
      function owns(data) {
        return signedIn() && (
          data.get('ownerUid', '') == request.auth.uid ||
          (data.get('ownerUid', '') == '' && storeId == request.auth.uid && data.get('uid', '') == request.auth.uid)
        );
      }
      function ownsThisStore() {
        return owns(get(/databases/$(database)/documents/stores/$(storeId)).data);
      }
      allow get: if signedIn() && (
        storeId == request.auth.uid || owns(resource.data) || scannerCanRead(storeId)
      );
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if owns(resource.data) && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if owns(resource.data);
      match /authorizedDevices/{deviceUid} {
        allow get: if ownsThisStore() || (signedIn() && request.auth.uid == deviceUid);
        allow list, delete: if ownsThisStore();
        allow create, update: if ownsThisStore()
          && request.resource.data.keys().hasOnly(['enabled'])
          && request.resource.data.enabled is bool;
      }
      match /products/{productId} {
        allow read: if ownsThisStore() || scannerCanRead(storeId);
        allow write: if ownsThisStore();
      }
    }
  }
}
